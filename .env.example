# Where the Laravel API (backend/) runs.
# Use "localhost", not 127.0.0.1, and open the app at http://localhost:3000, so the
# browser shares the sign-in cookies between the app and the API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Show the demo-account shortcuts on the sign-in page in production builds (they always
# show while developing). Leave false for real use.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false

# Set to false when the API sends real emails (MAIL_MAILER=smtp), to hide the 'look in laravel.log' hints.
NEXT_PUBLIC_EMAILS_IN_LOG=true
